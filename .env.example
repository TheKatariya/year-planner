# Supabase project that holds the planner_* tables.
# Create a project at https://supabase.com/dashboard, run
# supabase/migrations/0001_init.sql in the SQL Editor, then fill these in
# from Project Settings -> API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The service_role key. SECRET — server-side only, never NEXT_PUBLIC_.
# The planner tables have RLS on with no policies, so the anon key cannot
# read them; all access goes through server actions using this key.
SUPABASE_SERVICE_ROLE_KEY=
